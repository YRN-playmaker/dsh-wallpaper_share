{
  "name": "dsh-wallpaper_share",
  "description": "Sync active Wallpaper Engine wallpapers(image/video/scence/app)to DeepSeek Harness Web UI as a customizable dynamic background.",
  "version": "26.9.13",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node tools/check-package.mjs && tsdown",
    "bundle": "node tools/check-package.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none \"src/market/test/*.test.ts\" \"src/client/test/*.test.ts\" \"src/launcher/test/*.test.ts\" \"src/floater/test/*.test.ts\" \"src/workspace/test/*.test.ts\" \"src/daynight/test/*.test.ts\"",
    "check:package": "node tools/check-package.mjs",
    "test:package": "node --test tools/check-package.test.mjs",
    "prepack": "node tools/check-package.mjs"
  },
  "license": "GPL-3.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wallpaper-engine",
    "wallpaper",
    "background",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YRN-playmaker/dsh-wallpaper_share.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "bin/we-capture.exe",
    "bin/we-floater.exe",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "vendor/dwp/",
    "tools/scene-renderer/",
    "tools/check-package.mjs",
    "docs/encoding-and-release.md"
  ]
}
