{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "dwp-web": ["./vendor/dwp/packages/dwp-web/src/index.ts"],
      "dwp-core": ["./vendor/dwp/packages/dwp-core/src/index.ts"],
      "dwp-gl": ["./vendor/dwp/packages/dwp-gl/src/index.ts"]
    }
  },
  "include": ["src"]
}
